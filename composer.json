{
  "name": "ksfraser/eventloop",
  "description": "A set of classes for working with events, loops, notifications.",
  "type": "library",
  "authors": [
    {
      "name": "Kevin Fraser",
      "email": "kevin@ksfraser.ca"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "ksfraser/kflog": "dev-main",
    "ksfraser/exceptions": "*",
    "ksfraser/event": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Exceptions"
    },
    {
      "type": "path",
      "url": "../kfLog"
    },
    {
      "type": "path",
      "url": "../origin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../event"
    }
  ],
  "autoload": {
    "psr-4": {
      "Ksfraser\\Eventloop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eventloop\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  }
}